{
  "name": "@blendsdk/react",
  "version": "5.53.0",
  "private": true,
  "description": "React component and hook library for BlendSDK applications",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/blendsdk.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -fR ./dist",
    "test": "vitest run --passWithNoTests --reporter=verbose",
    "test:fast": "vitest run --passWithNoTests --reporter=verbose",
    "test:watch": "vitest watch --reporter=verbose",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@blendsdk/i18n": "5.53.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "react-router": "^8.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
