{
  "name": "@blendsdk/codegen",
  "version": "5.53.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/blendsdk.git",
    "directory": "packages/codegen"
  },
  "scripts": {
    "build": "tsc",
    "test:fast": "vitest run --reporter=verbose --no-file-parallelism --testTimeout=30000",
    "test:watch": "vitest watch --reporter=verbose",
    "clean": "rm -fR ./dist",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "db:up": "docker-compose -p codegen -f ./docker/docker-compose${MODE}.yml up -d && sleep 5",
    "db:down": "docker-compose -p codegen -f ./docker/docker-compose${MODE}.yml down -v --remove-orphans",
    "db:logs": "docker-compose -p codegen -f ./docker/docker-compose${MODE}.yml logs postgres-test",
    "test": "yarn db:down && yarn db:up && yarn test:fast && yarn db:down"
  },
  "dependencies": {
    "@blendsdk/cmdline": "^5.53.0",
    "@blendsdk/dbcore": "^5.53.0",
    "@blendsdk/postgresql": "^5.53.0",
    "@blendsdk/webafx": "^5.53.0",
    "jiti": "^2.7.0",
    "pg": "^8.22.0",
    "postgres-array": "^3.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
