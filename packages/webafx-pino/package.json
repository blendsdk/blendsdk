{
  "name": "@blendsdk/webafx-pino",
  "version": "5.53.0",
  "description": "Structured logging plugin for WebAFX with Pino — adapts pino behind the BlendSDK Logger interface",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/blendsdk.git",
    "directory": "packages/webafx-pino"
  },
  "scripts": {
    "build": "tsc",
    "test:fast": "vitest run --reporter=verbose",
    "test:watch": "vitest watch --reporter=verbose",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -fR ./dist",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "peerDependencies": {
    "@blendsdk/webafx": "5.53.0",
    "pino-pretty": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@blendsdk/webafx": "5.53.0",
    "@types/node": "^26.1.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  },
  "author": "TrueSoftware B.V.",
  "license": "MIT"
}
