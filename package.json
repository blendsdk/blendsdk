{
  "name": "@blendsdk/monorepo",
  "version": "5.66.0",
  "description": "BlendSDK v5 - Modern TypeScript SDK for Enterprise Applications",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.8.0 <13"
  },
  "packageManager": "pnpm@12.8.1",
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --concurrency=4",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "clean": "pnpm run self:clean && turbo run clean",
    "self:clean": "rm -rf .turbo",
    "docs": "turbo run docs",
    "docs:dev": "turbo run docs:dev",
    "ai-training:generate": "tsx --env-file=.env scripts/generate-ai-training.ts --provider deepseek",
    "docs:generate": "tsx scripts/generate-techdocs.ts --verbose",
    "docs:check": "tsx scripts/techdocs/check-drift.ts",
    "docs:scaffold": "tsx scripts/generate-techdocs.ts --verbose --scaffold",
    "docs:build": "tsx scripts/generate-techdocs.ts && cd packages/blendsdk-docs && npx vitepress build docs",
    "docs:preview": "tsx scripts/generate-techdocs.ts && cd packages/blendsdk-docs && npx vitepress dev docs",
    "skill:generate": "tsx scripts/skill/generate.ts",
    "skill:check": "tsx scripts/skill/check-drift.ts",
    "skill:freshness": "tsx scripts/skill/check-freshness.ts",
    "skill:validate": "tsx scripts/skill/validate-examples.ts",
    "skill:repair": "tsx scripts/skill/repair-examples.ts",
    "lockstep": "tsx scripts/lockstep.ts",
    "lockstep:version:auto": "tsx scripts/lockstep.ts version --type auto --ci",
    "lockstep:version:patch": "tsx scripts/lockstep.ts version --type patch --ci",
    "lockstep:version:minor": "tsx scripts/lockstep.ts version --type minor --ci",
    "lockstep:version:major": "tsx scripts/lockstep.ts version --type major --ci",
    "lockstep:publish:latest": "tsx scripts/lockstep.ts publish --tag latest --git-push",
    "lockstep:publish:v55": "tsx scripts/lockstep.ts publish --tag v55 --git-push",
    "ncu": "ncu -u --workspaces -x \"@blendsdk*\" && rm -fR node_modules pnpm-lock.yaml && pnpm install && pnpm build && MODE=-ci pnpm test",
    "skill:evaluate": "tsx scripts/skill/evaluate.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@manypkg/get-packages": "^3.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.5",
    "nodemailer": "^9.0.3",
    "npm-check-updates": "^23.0.0",
    "openai": "^7.3.0",
    "pino": "^10.3.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blendsdk/blendsdk.git"
  },
  "author": "TrueSoftware B.V.",
  "license": "MIT",
  "keywords": [
    "typescript",
    "sdk",
    "enterprise",
    "web-framework",
    "data-access",
    "monorepo"
  ]
}
